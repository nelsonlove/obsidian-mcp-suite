    "pretest": "npm --prefix ../core run build"
  },
  "dependencies": {
    "@vault-mcp/core": "*",
    "isomorphic-git": "^1.41.7",
    "vault-mcp-api": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
